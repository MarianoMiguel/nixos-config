// Trackpad-friendly window resizing. niri hardcodes interactive drag-resize
// to Mod+right-mouse-drag, which is awkward on a ThinkPad trackpad, so our
// niri is patched (overlays/niri-mod-shift-drag-resize.nix) to start the
// same resize on Mod+Shift+left-drag: real handles, no right button.
// Mod+Shift+MouseLeft must stay UNBOUND here — a bind would consume the
// press before the drag gesture is considered.
// All width/height actions here also apply to floating windows.
binds {
    // Two-finger click steps through the preset heights
    // (see preset-window-heights). Click = resize.
    Mod+Shift+MouseRight repeat=false hotkey-overlay-title="Resize: cycle height preset" {
        switch-preset-window-height;
    }

    // Hold Mod+Alt+Shift and two-finger scroll for fine 5% steps: vertical
    // scroll changes height, horizontal scroll changes width, so a diagonal
    // two-finger movement behaves like dragging a corner handle.
    // Plain Mod+scroll stays the workspace switcher, and Mod+Shift / Mod+Ctrl
    // scroll stay column navigation, so nothing existing is displaced.
    Mod+Alt+Shift+WheelScrollUp cooldown-ms=50 {
        set-window-height "-5%";
    }
    Mod+Alt+Shift+WheelScrollDown cooldown-ms=50 {
        set-window-height "+5%";
    }
    Mod+Alt+Shift+WheelScrollRight cooldown-ms=50 {
        set-column-width "+5%";
    }
    Mod+Alt+Shift+WheelScrollLeft cooldown-ms=50 {
        set-column-width "-5%";
    }
}
