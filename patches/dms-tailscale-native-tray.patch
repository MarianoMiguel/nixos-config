--- a/DMSShellIPC.qml
+++ b/DMSShellIPC.qml
@@ -249,3 +249,32 @@ Item {
+        function openSection(section: string): string {
+            if (!section)
+                return "CONTROL_CENTER_OPEN_SECTION_FAILED";
+
+            if (PopoutService.routeToIsland("controlcenter", null, false, section))
+                return "CONTROL_CENTER_OPEN_SECTION_SUCCESS";
+
+            const bar = root.getPreferredBar("controlCenterButtonRef");
+            if (!bar)
+                return "CONTROL_CENTER_OPEN_SECTION_FAILED";
+
+            root.controlCenterLoader.active = true;
+            Qt.callLater(() => {
+                const popout = root.controlCenterLoader.item;
+                if (!popout)
+                    return;
+                if (!popout.shouldBeVisible)
+                    bar.triggerControlCenter();
+                Qt.callLater(() => popout.openWithSection(section));
+            });
+            return "CONTROL_CENTER_OPEN_SECTION_SUCCESS";
+        }
+
+        function section(): string {
+            if (!root.controlCenterLoader.item)
+                return "";
+            return root.controlCenterLoader.item.expandedSection || "";
+        }
+
         function hide(): string {
             if (root.controlCenterLoader.item && root.controlCenterLoader.item.shouldBeVisible) {
                 root.controlCenterLoader.item.close();
