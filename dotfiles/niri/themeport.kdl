// Themeport's image-first DMS pickers. This lives in its own include because
// DMS regenerates dms/binds.kdl and would otherwise drop custom bindings.
binds {
    Mod+Ctrl+T hotkey-overlay-title="Preview themes" {
        spawn "mariano-dms-picker" "theme";
    }
    Mod+Ctrl+W hotkey-overlay-title="Preview wallpapers" {
        spawn "mariano-dms-picker" "wall";
    }
}

window-rule {
    match app-id=r#"^system\.actions$"#
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.6; }
}
