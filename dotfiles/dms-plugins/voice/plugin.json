{
    "id": "voice",
    "name": "Voice",
    "description": "Microphone state for dictation and the live voice agent, with approval prompts for anything the agent wants to run",
    "version": "1.0.0",
    "author": "Mariano Miguel",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget"],
    "icon": "mic",
    "components": {
        "daemon": "./VoiceDaemon.qml",
        "widget": "./VoiceWidget.qml"
    },
    "settings": "./VoiceSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ],
    "dependencies": ["voiceagent", "voxtype"]
}
