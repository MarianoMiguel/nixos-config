# Managed by themeport; `themeport set <name>` rewrites the theme file this
# name resolves to (~/.config/ghostty/themes/themeport).
theme = themeport
background-opacity = 1
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
command = direct:/run/current-system/sw/bin/zsh
env = SHELL=/run/current-system/sw/bin/zsh

font-family = IBM Plex Mono
# Keep Plex letterforms and give both Ghostty and cmux explicit icon fallbacks.
font-family = BlexMono Nerd Font
font-family = Symbols Nerd Font Mono
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD=Symbols Nerd Font Mono
font-size = 12
