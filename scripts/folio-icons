#!/usr/bin/env python3
"""Generate dotfiles/quickshell/folio/Common/Icons.qml from the workshop kit.

The studies' icons (workshop/studies/_kit/folio.js, ICONS) are the source of
truth; the shell draws the same shapes with QtQuick.Shapes. Circles and rects
become path data so every shape is one ShapePath.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KIT = ROOT / "workshop/studies/_kit/folio.js"
OUT = ROOT / "dotfiles/quickshell/folio/Common/Icons.qml"

ATTR = re.compile(r'([\w-]+)="([^"]*)"')
ELEM = re.compile(r"<(path|circle|rect)\s([^>]*?)/?>")


def num(v):
    return float(v)


def rect_path(x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    if r <= 0:
        return f"M{x},{y}h{w}v{h}h{-w}z"
    return (f"M{x + r},{y}h{w - 2 * r}a{r},{r} 0 0 1 {r},{r}v{h - 2 * r}a{r},{r} 0 0 1 {-r},{r}"
            f"h{-(w - 2 * r)}a{r},{r} 0 0 1 {-r},{-r}v{-(h - 2 * r)}a{r},{r} 0 0 1 {r},{-r}z")


def circle_path(cx, cy, r):
    return f"M{cx - r},{cy}a{r},{r} 0 1 0 {2 * r},0a{r},{r} 0 1 0 {-2 * r},0z"


def shapes(fragment):
    out = []
    for kind, attrs in ELEM.findall(fragment):
        a = dict(ATTR.findall(attrs))
        if kind == "path":
            d = a["d"]
        elif kind == "circle":
            d = circle_path(num(a["cx"]), num(a["cy"]), num(a["r"]))
        else:
            d = rect_path(num(a.get("x", 0)), num(a.get("y", 0)), num(a["width"]), num(a["height"]), num(a.get("rx", 0)))
        fill = a.get("fill") == "currentColor"
        stroke = a.get("stroke") != "none"
        out.append({"d": d, "fill": fill, "stroke": stroke, "w": num(a["stroke-width"]) if "stroke-width" in a else 0})
    return out


def main():
    source = KIT.read_text()
    block = source[source.index("const ICONS = {"):source.index("};", source.index("const ICONS = {"))]
    icons = {}
    for name, frag in re.findall(r"^\s+(\w+): '(.*)',?$", block, re.M):
        icons[name] = shapes(frag)
    if not icons:
        sys.exit("no icons found in the kit")
    body = json.dumps(icons, indent=None, separators=(",", ":"))
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(f"""pragma Singleton
import QtQuick
import Quickshell

// Generated by scripts/folio-icons from workshop/studies/_kit/folio.js; do not
// edit. Shapes on a 24-unit grid: d is SVG path data, fill draws it solid,
// stroke outlines it (w overrides the stroke width).
Singleton {{
    readonly property var shapes: {body}
    function get(name) {{ return shapes[name] || []; }}
}}
""")
    print(f"wrote {OUT.relative_to(ROOT)} ({len(icons)} icons)")


if __name__ == "__main__":
    main()
