{
  config,
  lib,
  pkgs,
  pkgsPond,
  pond-interface,
  pond-vicinae,
  ...
}:

# Pond (github.com/bflycomputer) as an extra niri login session. DMS stays the
# default session until the parity board in workshop/ says otherwise; nothing
# here touches ~/.config/niri. See workshop/README.md.
let
  cfg = config.mariano.pond;
  niri = config.programs.niri.package;

  pondFonts = pkgs.callPackage ../../packages/pond-fonts.nix { };
  pondVicinae = pkgs.callPackage ../../packages/pond-vicinae.nix {
    inherit pkgsPond;
    src = pond-vicinae;
  };
  # Pond targets Qt 6.12 and Quickshell 0.3.2; see packages/pond-interface.nix.
  pondInterface = pkgsPond.callPackage ../../packages/pond-interface.nix {
    src = pond-interface;
    vicinae = pondVicinae;
  };

  share = "${pondInterface}/share/pond-interface";
  # Stable path for symlinks under $HOME; store paths there would dangle
  # after garbage collection.
  stableShare = "/etc/pond-interface";

  lock = pkgs.writeShellScript "pond-lock" ''
    exec ${pondInterface.python}/bin/python3 ${share}/shell/settings/session.py lock
  '';

  # Pond has no idle handling of its own. Mirror the DMS policy
  # (dotfiles/dms/settings-defaults.json, modules/nixos/home.nix): lock after
  # 5 min on battery or 10 min on AC, screens off shortly after, and hibernate
  # after 15 min on battery only. Suspend is disabled in power.nix.
  idle = pkgs.writeShellScript "pond-idle" ''
    on_battery() {
      for supply in /sys/class/power_supply/*; do
        [ "$(cat "$supply/type" 2>/dev/null)" = Mains ] || continue
        [ "$(cat "$supply/online" 2>/dev/null)" = 1 ] && return 1
      done
      ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1
    }

    case "$1" in
      lock) exec ${lock} ;;
      battery-lock) on_battery && exec ${lock} ;;
      monitors-off) exec ${niri}/bin/niri msg action power-off-monitors ;;
      battery-monitors-off) on_battery && exec ${niri}/bin/niri msg action power-off-monitors ;;
      monitors-on) exec ${niri}/bin/niri msg action power-on-monitors ;;
      battery-hibernate) on_battery && exec ${pkgs.systemd}/bin/systemctl hibernate ;;
    esac
    exit 0
  '';

  # Additions to Pond's niri config. Pond's own files stay untouched; this is
  # included after them, so it can only add.
  sessionKdl = pkgs.writeText "pond-nixos.kdl" ''
    // Generated by modules/nixos/pond.nix. Edit there, not here.

    spawn-at-startup "${pkgs.systemd}/bin/systemctl" "--user" "start" "pond-vicinae.service"
    spawn-at-startup "${pkgs.polkit_gnome}/libexec/polkit-gnome-authentication-agent-1"
    spawn-at-startup "${pkgs.swayidle}/bin/swayidle" "-w" "timeout" "300" "${idle} battery-lock" "timeout" "330" "${idle} battery-monitors-off" "resume" "${idle} monitors-on" "timeout" "600" "${idle} lock" "timeout" "660" "${idle} monitors-off" "resume" "${idle} monitors-on" "timeout" "900" "${idle} battery-hibernate" "before-sleep" "${idle} lock"

    // Our tools, on keys Pond leaves free.
    binds {
        Alt+Shift+3 repeat=false hotkey-overlay-title="Capture All Displays" { spawn "mariano-capture" "screenshot-full"; }
        Alt+Shift+4 repeat=false hotkey-overlay-title="Capture Region" { spawn "mariano-capture" "screenshot-region"; }
        Alt+Shift+5 repeat=false hotkey-overlay-title="Start or Stop Region Recording" { spawn "mariano-capture" "video-toggle"; }
    }

    include "${../../dotfiles/niri/voice.kdl}"
  '';

  # Pond's skel config.kdl plus our include. Copied (not linked) at every
  # login so its relative includes resolve inside ~/.config/pond/niri.
  configKdl = pkgs.writeText "pond-config.kdl" ''
    ${builtins.readFile "${pond-interface}/config/niri/config.kdl"}

    // NixOS session additions (modules/nixos/pond.nix).
    include "./nixos.kdl"
  '';

  # A preview must never lock, blank or hibernate the host it runs inside.
  previewKdl = pkgs.writeText "pond-preview.kdl" ''
    spawn-at-startup "${pondVicinae}/bin/vicinae" "server" "--replace"
  '';

  # Pond in a nested niri window from any running session, with its config,
  # state and Quickshell lookup isolated under a temporary directory. Used to
  # look at a Pond update before activating it (workshop/UPSTREAMS.md).
  preview = pkgs.writeShellScriptBin "pond-preview" ''
    set -eu
    root=$(mktemp -d "''${XDG_RUNTIME_DIR:-/tmp}/pond-preview.XXXXXX")
    dir=$root/config/pond/niri
    mkdir -p "$dir/cfg" "$root/xdg/quickshell" "$root/state"
    ln -s ${share}/config/niri/shell "$dir/shell"
    for default in ${share}/config/niri/cfg/*.kdl; do
      cat "$default" > "$dir/cfg/$(basename "$default")"
    done
    ln -s ${previewKdl} "$dir/nixos.kdl"
    cat ${configKdl} > "$dir/config.kdl"
    ln -s ${share}/shell "$root/xdg/quickshell/pond-shell"
    ln -s ${share}/lockscreen "$root/xdg/quickshell/pond-lockscreen"
    echo "pond-preview: $root" >&2

    export XDG_CONFIG_HOME=$root/config XDG_STATE_HOME=$root/state
    export XDG_CONFIG_DIRS="$root/xdg:''${XDG_CONFIG_DIRS:-/etc/xdg}"
    export POND_NIRI_CONFIG_DIR=$dir POND_PAM_SERVICE=login GTK_THEME=Adwaita:dark
    unset NIRI_SOCKET
    exec ${niri}/bin/niri --config "$dir/config.kdl"
  '';

  prepare = pkgs.writeShellScript "pond-session-prepare" ''
    set -eu
    dir="$HOME/.config/pond/niri"
    mkdir -p "$dir/cfg"
    ln -sfn ${stableShare}/config/niri/shell "$dir/shell"
    ln -sfn /etc/pond-session/nixos.kdl "$dir/nixos.kdl"

    # Pond's personal settings are seeded once, then owned by Pond's settings
    # panels, exactly like /etc/skel on Arch.
    for default in ${share}/config/niri/cfg/*.kdl; do
      name=$(basename "$default")
      [ -e "$dir/cfg/$name" ] && continue
      if [ "$name" = input.kdl ]; then
        # Deliberate deviation (workshop/parity.json): conventional scroll
        # direction, as in dotfiles/niri/config.kdl.
        sed -E '/^[[:space:]]*natural-scroll([[:space:]]|$)/d' "$default" > "$dir/cfg/$name"
      else
        cat "$default" > "$dir/cfg/$name"
      fi
    done
    cat ${configKdl} > "$dir/config.kdl"

    if [ ! -e "$HOME/.config/kitty" ]; then
      mkdir -p "$HOME/.config/kitty"
      cat ${share}/config/kitty/kitty.conf > "$HOME/.config/kitty/kitty.conf"
      ln -s ${stableShare}/config/kitty/themes/default.conf "$HOME/.config/kitty/current-theme.conf"
    fi
  '';

  # niri-session, but starting pond-niri.service with Pond's config. A
  # separate unit keeps NIRI_CONFIG out of the user manager's environment,
  # where it would leak into the next DMS login.
  sessionLauncher = pkgs.writeShellScript "pond-session" ''
    if [ -n "''${SHELL:-}" ] && grep -q "$SHELL" /etc/shells \
        && ! (echo "$SHELL" | grep -q false) && ! (echo "$SHELL" | grep -q nologin); then
      if [ "''${1:-}" != -l ]; then
        exec ${pkgs.bash}/bin/bash -c "exec -l '$SHELL' -c '$0 -l $*'"
      else
        shift
      fi
    fi

    systemctl=${pkgs.systemd}/bin/systemctl
    if $systemctl --user -q is-active niri.service pond-niri.service; then
      echo 'A niri session is already running.' >&2
      exit 1
    fi
    $systemctl --user reset-failed
    ${prepare}
    $systemctl --user import-environment
    ${pkgs.dbus}/bin/dbus-update-activation-environment --all
    $systemctl --user --wait start pond-niri.service
    $systemctl --user start --job-mode=replace-irreversibly niri-shutdown.target
    $systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP NIRI_SOCKET
  '';

  sessionPackage =
    pkgs.runCommand "pond-wayland-session" { passthru.providedSessions = [ "pond" ]; }
      ''
        install -Dm444 /dev/stdin $out/share/wayland-sessions/pond.desktop <<EOF
        [Desktop Entry]
        Name=Pond
        Comment=Pond desktop on niri (workshop session)
        Exec=${sessionLauncher}
        Type=Application
        DesktopNames=niri
        EOF
      '';
in
{
  options.mariano.pond.enable = lib.mkEnableOption "the Pond desktop as an extra niri login session";

  config = lib.mkIf cfg.enable {
    # desktop.nix forces this list; definitions at the same priority merge.
    services.displayManager.sessionPackages = lib.mkForce [ sessionPackage ];

    # DMS must never run inside the Pond session. librepods.service starts with
    # every graphical session and wants dms.service, and DMS is also D-Bus
    # activatable, so guard the unit itself; the DMS session is unaffected.
    systemd.user.services.dms.serviceConfig.ExecCondition =
      pkgs.writeShellScript "dms-not-in-pond-session" ''
        case "$(${pkgs.systemd}/bin/systemctl --user is-active pond-niri.service)" in
          active | activating | reloading) exit 1 ;;
        esac
      '';

    # Raw units: NixOS-generated user units would pin PATH and hide the login
    # environment from niri and everything it spawns.
    systemd.user.units = {
      "pond-niri.service".text = ''
        [Unit]
        Description=Pond desktop on niri
        BindsTo=graphical-session.target
        Before=graphical-session.target
        Wants=graphical-session-pre.target
        After=graphical-session-pre.target
        Wants=xdg-desktop-autostart.target
        Before=xdg-desktop-autostart.target

        [Service]
        Slice=session.slice
        Type=notify
        Environment=POND_NIRI_CONFIG_DIR=%h/.config/pond/niri
        Environment=POND_PAM_SERVICE=pond-lock
        Environment=GTK_THEME=Adwaita:dark
        ExecStart=${niri}/bin/niri --session --config %h/.config/pond/niri/config.kdl
      '';

      "pond-vicinae.service".text = ''
        [Unit]
        Description=Vicinae launcher server (Pond fork)
        PartOf=graphical-session.target
        After=graphical-session.target
        Requires=dbus.socket

        [Service]
        Type=simple
        ExecStart=${pondVicinae}/bin/vicinae server --replace
        Restart=on-failure
        RestartSec=5
        KillMode=process
      '';
    };

    environment.etc = {
      "pond-interface".source = share;
      "pond-session/nixos.kdl".source = sessionKdl;
      # Arch: pond-shell and pond-lockscreen link these into /etc/xdg.
      "xdg/quickshell/pond-shell".source = "${share}/shell";
      "xdg/quickshell/pond-lockscreen".source = "${share}/lockscreen";
      "xdg/kitty/kitty.conf".source = "${share}/config/kitty/etc/kitty.conf";
      "xdg/fastfetch/config.jsonc".source = "${share}/config/fastfetch/config.jsonc";
    };

    # Pond's lock screen only drives a password conversation.
    security.pam.services.pond-lock.fprintAuth = false;

    # External-monitor brightness through ddcutil, as pond-shell expects.
    hardware.i2c.enable = true;
    users.users.mariano.extraGroups = [ "i2c" ];

    system.build.pondPreview = preview;

    environment.systemPackages = with pkgs; [
      preview
      capitaine-cursors
      ddcutil
      fastfetch
      grim # scripts/workshop capture
      iw
      kitty
      wl-clipboard
      zenity
    ];

    fonts.packages = [
      pondFonts
      pondInterface
      pkgs.ibm-plex
      pkgs.jetbrains-mono
    ];

    # Pond's title face (Pond Gramercy) is proprietary and not published. Its
    # outlined uses in Pond's artwork (the manual title) are a serif.
    fonts.fontconfig.localConf = ''
      <alias>
        <family>Pond Gramercy</family>
        <prefer><family>serif</family></prefer>
      </alias>
    '';
  };
}
