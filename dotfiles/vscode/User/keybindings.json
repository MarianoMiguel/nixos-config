[

  // { "key": "ctrl+u", "command": "scrollPageUp", "when": "editorTextFocus" },

  // { "key": "ctrl+d", "command": "scrollPageDown", "when": "editorTextFocus" },

  {

   "key": "alt+right",

   "command": "cursorEnd",

   "when": "textInputFocus"

  },

  {

   "key": "alt+left",

   "command": "cursorHome",

   "when": "textInputFocus"

  },

  // Alt + Shift + Right -> Select to end of line

  {

   "key": "shift+alt+right",

   "command": "cursorEndSelect",

   "when": "textInputFocus"

  },

  // Alt + Shift + Left -> Select to start of line

  {

   "key": "shift+alt+left",

   "command": "cursorHomeSelect",

   "when": "textInputFocus"

  },



