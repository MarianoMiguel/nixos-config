// Mariano's manifesto: a dedicated, theme-aware floating terminal window.
// This lives outside dms/binds.kdl because DMS regenerates that file.
binds {
    Mod+Ctrl+M repeat=false hotkey-overlay-title="Open manifesto" {
        spawn "manifesto-window";
    }
}

window-rule {
    match app-id=r#"^mariano\.manifesto$"#
    open-floating true
    open-focused true
    default-column-width { proportion 0.58; }
    default-window-height { proportion 0.82; }
}
