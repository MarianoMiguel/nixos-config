{
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "database-client.autoSync": true,
  "editor.accessibilitySupport": "off",
  "editor.codeLensFontFamily": "CaskaydiaMono Nerd Font Mono",
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 0,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorWidth": 2,
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontSize": 13,
  "editor.fontWeight": "400",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.inlayHints.fontFamily": "CaskaydiaMono Nerd Font Mono",
  "editor.inlineSuggest.fontFamily": "CaskaydiaMono Nerd Font Mono",
  "editor.lineHeight": 1.9,
  "editor.tabSize": 2,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "emmet.includeLanguages": {
    "erb": "html",
    "ruby": "ruby",
  },
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "github.copilot.chat.byok.ollamaEndpoint": "http://localhost:10000",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "scm.inputFontFamily": "CaskaydiaMono Nerd Font Mono",
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.gpuAcceleration": "off",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vscode_custom_css.imports": [
    "file://C:/Users/maria/.config/vscode/theme.css",
    "file:///home/mariano/.config/vscode/theme.css",
    "file:///Users/marianomiguel/.config/vscode/theme.css",
  ],
  "vscode_vibrancy.opacity": 0,
  "vscode_vibrancy.theme": "Catppuccin Mocha",
  "window.autoDetectColorScheme": false,
  "window.systemColorTheme": "dark",
  "window.titleBarStyle": "custom",
  "workbench.editor.empty.hint": "hidden",
  "workbench.iconTheme": "catppuccin-perfect-dark",
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "terminal.integrated.fontFamily": "CaskaydiaMono Nerd Font Mono",
  "omarchyThemeSync.folderToVSCodeTheme": {
    "osaka-jade": "Gruvbox Glass",
    "catppuccin": "Catppuccin Mocha",
    "kanagawa": "Kanagawa",
    "tokyo-night": "Tokyo Night Horizon",
  },
  "omarchyThemeSync.defaultVSCodeTheme": "Gruvbox Glass",
  "omarchyThemeSync.warnIfThemeMissing": true,
  "traycer.additionalAgents": ["Claude Code"],
  "traycer.enableAutoAnalysis": false,
  "traycer.alwaysAllowPayToRun": true,
  "window.enableMenuBarMnemonics": false,
  "window.customMenuBarAltFocus": false,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "github.copilot.chat.codeGeneration.instructions": [],
  "git.openRepositoryInParentFolders": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "laravel-pint.enable": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "aitk-github:aitk",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "C:\\Users\\mariano\\.aitk\\instructions\\": true,
  },
  "workbench.editorAssociations": {
    "git-rebase-todo": "default",
  },
  "chat.useAgentSkills": true,
  "workbench.preferredDarkColorTheme": "Vesper",
  "chat.mcp.gallery.enabled": true,
  "workbench.colorTheme": "Monokai Pro (Filter Spectrum)",
}