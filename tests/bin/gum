#!/usr/bin/env bash
set -euo pipefail

command_name=${1:-}
shift || true

pop_response() {
  local queue=$1
  local response rest

  [[ -f $queue ]] || {
    printf 'Missing gum response queue: %s\n' "$queue" >&2
    exit 1
  }
  IFS= read -r response < "$queue" || true
  rest="$queue.rest"
  sed '1d' "$queue" > "$rest"
  mv "$rest" "$queue"
  printf '%s\n' "$response"
}

case $command_name in
  style)
    printf '%s\n' "$*"
    ;;
  choose)
    pop_response "${INSTALLER_GUM_CHOOSE_QUEUE:?INSTALLER_GUM_CHOOSE_QUEUE is required}"
    ;;
  input)
    pop_response "${INSTALLER_GUM_INPUT_QUEUE:?INSTALLER_GUM_INPUT_QUEUE is required}"
    ;;
  spin)
    while (( $# > 0 )) && [[ $1 != -- ]]; do
      shift
    done
    [[ ${1:-} == -- ]] && shift
    "$@"
    ;;
  *)
    printf 'Unexpected gum command in preview test: %s\n' "$command_name" >&2
    exit 1
    ;;
esac
