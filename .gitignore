result
result-*
.direnv
.envrc
*.tar.zst
*.tar.zst.age
*.manifest.txt
payload/
__pycache__/
.omo/
# Agent worktrees.
/.claude/worktrees/
# A guided install writes each machine's storage.nix. Bonhart's is tracked:
# Update All builds committed files only, and it holds no secrets.
hosts/*/storage.nix
!hosts/bonhart/storage.nix
*.iso
# Folio shell shaders are compiled by scripts/folio-harness and the Nix package.
dotfiles/quickshell/folio/shaders/*.qsb
dotfiles/quickshell/folio/Modules/*/qmldir
# Built from nixpkgs' unicode-emoji and cldr-annotations by scripts/folio-emoji.
dotfiles/quickshell/folio/Modules/Launcher/emoji.json
# Synthesized by scripts/folio-sounds (the harness and the Nix package run it).
dotfiles/quickshell/*/sounds/
# The owner's own pictures (tools/azure-folio/pictures.py) live in
# ~/Pictures/Folio and their prints in the cache, never in the repository;
# these catch a folder or store that ends up here by mistake.
/Pictures/
**/folio-pictures/
**/folio-pictures-store/
**/azure-folio/pictures/
